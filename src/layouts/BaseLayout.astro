---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Elsewhere from "../components/Elsewhere.astro";
import "../styles/main.css";

interface Props {
  title?: string;
  description?: string;
  showElsewhere?: boolean;
}

const { title = "Home", description = "Peter Binkowski is a design engineer in Chicago, building systems and tools that bring design and engineering together.", showElsewhere = true } = Astro.props;

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#fdfdfc" />
    <title>{title === "Home" ? "Peter Binkowski — Design Engineer" : `${title} — Peter Binkowski`}</title>

    <!-- Apply the saved or system theme before the page is painted. -->
    <script is:inline>
      (function () {
        const savedTheme = localStorage.getItem("theme");
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;

        // Light is default; only go dark if explicitly saved or system prefers dark
        if (savedTheme === "dark" || (!savedTheme && prefersDark)) {
          document.documentElement.setAttribute("data-theme", "dark");
        } else {
          document.documentElement.setAttribute("data-theme", "light");
        }

      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="site-wrapper">
      <Header currentPath={currentPath} />

      <main class="site-main" id="main-content" tabindex="-1">
        <div class="content-area">
          <slot />
        </div>
      </main>
      {showElsewhere && <Elsewhere />}

      <Footer />
    </div>
  </body>
</html>
