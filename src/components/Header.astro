---
import Nav from "./Nav.astro";

interface Props {
  currentPath?: string;
}

const { currentPath = "" } = Astro.props;

---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="site-identity" aria-label="Peter Binkowski, home">
      <span class="site-name">Peter Binkowski</span>
      <span class="site-location">Design engineer, Chicago</span>
    </a>
    <Nav currentPath={currentPath} />
  </div>
</header>

