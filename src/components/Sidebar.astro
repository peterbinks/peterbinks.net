---
import LastPlayed from "./LastPlayed.astro";
import { currentBook } from "../data/books";

const socialLinks = [
  { href: "https://twitter.com/peterbinks", label: "Twitter" },
  { href: "https://bsky.app/profile/peterbinks.bsky.social", label: "Bluesky" },
  { href: "https://social.lol/@peterbinks", label: "Mastodon" },
  { href: "https://github.com/peterbinks", label: "GitHub" },
  { href: "https://codepen.io/peterbinks", label: "CodePen" },
  { href: "https://linkedin.com/in/peterbinkowski", label: "LinkedIn" },
  { href: "mailto:peter@peterbinks.net", label: "Email" },
];
---

<aside class="sidebar" aria-label="Elsewhere and current interests">

  <section class="sidebar-section">
    <h2 class="sidebar-title">Elsewhere</h2>
    <ul class="sidebar-list">
      {
        socialLinks.map((link) => (
          <li>
            <a href={link.href} target="_blank" rel="noopener noreferrer">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <LastPlayed />

  <section class="sidebar-section">
    <h2 class="sidebar-title">On the nightstand</h2>
    <a href="/reading" class="now-reading-content">
      <img src={currentBook.thumbnail} alt="" class="book-cover" width="44" height="68" loading="lazy" />
      <div class="book-info">
        <span class="book-title">{currentBook.title}</span>
        <span class="book-author">{currentBook.author}</span>
      </div>
    </a>
  </section>
</aside>
