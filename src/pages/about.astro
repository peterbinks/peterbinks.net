---
import BaseLayout from "../layouts/BaseLayout.astro";

const career = [
  { title: "Kin Insurance", tags: "Design System lead" },
  { title: "Kin Insurance", tags: "Senior Software Engineer" },
  { title: "Neoteric Design", tags: "Front end dev, & designer" },
];
---

<BaseLayout title="About">
  <header class="page-header">
    <h1>About</h1>
  </header>
  <section class="about-content prose">
    <section class="about-section">
      <h2>Hi, I’m Peter.</h2>
      <p>My name is Peter. I make websites. I live in Chicago.</p>
      <p>
        I enjoy a well brewed cup of coffee, rainy days, and the oxford comma. When not behind a screen I am reading a <a
          href="/reading">book</a
        >, making music on my drum kit, or spending quality time with my wife.
      </p>
    </section>

    <section class="about-section">
      <h2>A few things I’m into</h2>
      <ul class="interest-list">
        <li>Typography & Type Design</li>
        <li>Web Animations & Interactions</li>
        <li>Design Systems</li>
        <li>Accessibility</li>
        <li>Donuts</li>
      </ul>
    </section>

    <section class="about-section">
      <h2>Where I’ve been</h2>
      <ul class="career-list">
        {
          career.map((job) => (
            <li>
              <span class="title">{job.title}</span>
              <span class="action">{job.tags}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="about-section">
      <h2>Colophon</h2>
      <p>
        This site is the hundredth revision of peterbinks.net. I've used half a dozen CMSs, and put up a bunch of junk
        over the years.
      </p>
      <p>
        Built with <a href="https://astro.build">Astro</a>, set in whatever typeface your system prefers.
        A little space for my work, writing, and things worth keeping.
      </p>
    </section>

    <section class="about-section">
      <h2>Say hello</h2>
      <p>
        The best way to reach me is via <a href="mailto:peter@peterbinks.net">email</a>. You can also find me on <a
          href="https://twitter.com/peterbinks">Twitter</a
        > or <a href="https://github.com/peterbinks">GitHub</a>.
      </p>
    </section>
  </section>
</BaseLayout>

<style>
  .about-section + .about-section {
    margin-top: var(--space-7);
  }

  .about-section h2 {
    margin: 0 0 var(--space-4);
  }

  .interest-list,
  .career-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .interest-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
  }

  .career-list li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2) var(--space-5);
    margin: 0 0 var(--space-2);
  }

  .career-list .title {
    color: var(--text-primary);
  }

  .career-list .action {
    font-size: var(--font-size-sm);
    color: var(--text-muted);
  }
</style>
