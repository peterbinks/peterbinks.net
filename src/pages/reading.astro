---
import BaseLayout from "../layouts/BaseLayout.astro";
import { books } from "../data/books";
---

<BaseLayout title="Reading">
  <header class="page-header">
    <p class="eyebrow">On the bookshelf</p>
    <h1>Reading.</h1>
    <p class="page-description">Good company, one book at a time.</p>
  </header>


  <section class="books-list">
    {
      books.map((book) => (
        <article class="book-entry">
          <div class="book-content">
            {book.image && <img src={book.image} alt={book.title} class="book-cover" />}
            <div class="book-info">
              <p class="book-status eyebrow">{book.status.toLowerCase()}</p>
              <h2 class="book-title">{book.title}</h2>
              <div class="book-author">by {book.author}</div>
              <p class="book-description">{book.description}</p>
            </div>
          </div>
        </article>
      ))
    }
  </section>
</BaseLayout>

<style>
  .book-entry {
    border-top: 1px solid var(--border-subtle);
    padding: var(--space-7) 0;
  }

  .book-content {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr);
    align-items: start;
    gap: var(--space-7);
    max-width: 48rem;
  }

  .book-cover {
    width: 100%;
    height: auto;
  }

  .book-status {
    margin-bottom: var(--space-3);
  }

  .book-title {
    margin-bottom: var(--space-2);
  }

  .book-author {
    color: var(--text-muted);
    font-size: var(--font-size-sm);
    margin-bottom: var(--space-5);
  }

  .book-description {
    max-width: 36em;
  }

  @media (max-width: 480px) {
    .book-content {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }

    .book-cover {
      width: 6rem;
    }
  }
</style>
