---
import BaseLayout from "../layouts/BaseLayout.astro";
import { quotes } from "../data/quotes";
---

<BaseLayout title="Quotes">
  <header class="page-header">
    <h1>Quotes</h1>
    <p class="page-description">A collection of other people’s wisdom.</p>
  </header>

  <section class="quotes-list">
    {
      quotes.map((item) => (
        <figure class="quote-block">
          <blockquote class="quote-text">{item.quote}</blockquote>
          <figcaption class="quote-author">{item.author}</figcaption>
        </figure>
      ))
    }
  </section>
</BaseLayout>

<style>
  .quote-block {
    margin-bottom: var(--space-6);
  }

  .quote-text {
    border: 0;
    padding: 0;
    margin: 0 0 var(--space-2);
    color: var(--text-primary);
  }

  .quote-author {
    color: var(--text-muted);
    font-size: var(--font-size-sm);
  }
</style>
