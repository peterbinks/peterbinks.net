---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const projects = await getCollection("work", ({ data }) => {
  return data.draft !== true;
});

// Sort by order field
const sortedProjects = projects.sort((a, b) => {
  const orderA = a.data.order ?? 999;
  const orderB = b.data.order ?? 999;
  return orderA - orderB;
});
---

<BaseLayout title="Work">
  <header class="page-header">
    <p class="eyebrow">Design & engineering</p>
    <h1>Selected work.</h1>
    <p class="page-description">Systems, websites, and collaborations.</p>
  </header>


  <section class="projects-grid">
    {
      sortedProjects.map((project) => (
        <a href={`/work/${project.slug}`} class="project-card-link">
          <article class="project-card">
            <div class="project-content">
              <h2 class="project-title">
                {project.data.title}
              </h2>
              <p class="project-description">{project.data.description}</p>
              <div class="project-tags">
                {project.data.tags?.map((tag) => (
                  <span class="project-tag">{tag}</span>
                ))}
              </div>
            </div>
            <span class="item-arrow" aria-hidden="true">↗</span>
          </article>
        </a>
      ))
    }
  </section>
</BaseLayout>
