---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const projects = await getCollection("work", ({ data }) => {
  return data.draft !== true;
});

// Sort by order field
const sortedProjects = projects.sort((a, b) => {
  const orderA = a.data.order ?? 999;
  const orderB = b.data.order ?? 999;
  return orderA - orderB;
});
---

<BaseLayout title="Work">
  <header class="page-header">
    <h1>Work</h1>
    <p class="page-description">Systems, websites, and collaborations.</p>
  </header>

  <ul class="content-list">
    {
      sortedProjects.map((project) => (
        <li>
          <a href={`/work/${project.slug}`} class="content-link">
            <h2 class="item-title">{project.data.title}</h2>
            <p class="item-description">{project.data.description}</p>
            {project.data.tags && <span class="item-meta meta">{project.data.tags.join(" · ")}</span>}
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
